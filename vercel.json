{
  "version": 2,
  "builds": [
    {
      "src": "api/**/*.js",
      "use": "@vercel/node"
    },
    {
      "src": "BetterConversationsAPI/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/BetterConversationsAPI/(.*)",
      "dest": "/BetterConversationsAPI/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/BetterConversationsAPI/index.html"
    }
  ]
}
